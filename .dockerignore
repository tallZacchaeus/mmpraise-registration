# Keep the build context small and, more importantly, keep secrets and local
# state out of the image. Anything listed here is invisible to `docker build`.

.git
.github
node_modules
.next
out
build
coverage
playwright-report
test-results

# Secrets — the container gets its configuration from the environment, never
# from a file baked into the image.
.env
.env.*
!.env.example

# Local uploads and generated mail. In production these live on a mounted
# volume or in object storage.
storage

# Generated on install inside the image; a host copy would be built for the
# host's platform and can break the container.
src/generated

# Not needed to run the app.
tests
docs
*.md
!README.md
.claude
.vscode
.idea
.DS_Store
playwright.config.ts
vitest.config.mts
